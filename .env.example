#### Variables Postgres, partagées entre le service db et le service api
POSTGRES_USER=formbuilder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=formbuilder

#### Utilisées côté FastAPI (app/config.py) pour construire l'URL de connexion
POSTGRES_HOST=db
POSTGRES_PORT=5432

#### Optionnel : ports exposés sur la machine hôte, à changer en cas de conflit
#### avec un autre service déjà présent. Valeurs par défaut si absentes : 8000/8080.
# API_PORT=8000
# FRONTEND_PORT=8080
